---
import { isGamePublishable, type Game } from '../data/games';
const { game } = Astro.props as { game: Game };
const canLoad = isGamePublishable(game);
---
<section class="player-wrap" aria-label={`${game.name} game player`}><div class="player" data-player data-embed={canLoad?game.embedUrl:''} data-name={game.name}><div class="player-inner"><img class="player-cover" src={game.imageUrl} alt=""/><div class="player-start"><span class="eyebrow">READY WHEN YOU ARE</span><h2>{game.name}</h2>{canLoad?<><p>The game is provided by HTMLGames and may show ads or use cookies. Choose Play to connect to the provider.</p><button class="button" type="button" data-play>Play game ▶</button><a class="small-link" href="/privacy/">Privacy details</a></>:<><p>This puzzle is being checked before browser play is enabled.</p><a class="button" href={game.sourceUrl} target="_blank" rel="noopener noreferrer">Visit game source ↗</a></>}</div></div></div><div class="player-toolbar"><span data-player-status aria-live="polite">{canLoad?'Loads only when you press Play':'Preview · game check pending'}</span><div><button type="button" data-reload hidden>Reload</button><button type="button" data-fullscreen hidden>Full screen ⛶</button></div></div><p class="player-help">Game not loading? <a href={game.embedUrl} target="_blank" rel="noopener noreferrer">Open the provider’s player ↗</a>. {game.slug === 'traffic-puzzle' ? 'On a phone, use portrait for this game.' : 'On a phone, rotate to landscape to play.'}</p></section>
<script>
document.querySelectorAll<HTMLElement>('.player-wrap').forEach(wrap=>{
const player=wrap.querySelector<HTMLElement>('[data-player]')!;const status=wrap.querySelector<HTMLElement>('[data-player-status]')!;const full=wrap.querySelector<HTMLButtonElement>('[data-fullscreen]')!;const reload=wrap.querySelector<HTMLButtonElement>('[data-reload]')!;
const load=()=>{const url=player.dataset.embed;if(!url?.startsWith('https://'))return;const frame=document.createElement('iframe');frame.src=url;frame.title=player.dataset.name+' game';frame.allowFullscreen=true;frame.addEventListener('load',()=>{status.textContent='Player connected · use the game’s controls to begin';});status.textContent='Connecting to HTMLGames…';player.replaceChildren(frame);full.hidden=false;reload.hidden=false;window.setTimeout(()=>{if(status.textContent==='Connecting to HTMLGames…')status.textContent='Still connecting. Try Reload or open the provider’s player below.';},15000);};
document.addEventListener('fullscreenchange',()=>{full.textContent=document.fullscreenElement === wrap ? 'Exit full screen ⛶' : 'Full screen ⛶';});
player.querySelector('[data-play]')?.addEventListener('click',load);reload.addEventListener('click',load);full.addEventListener('click',async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await wrap.requestFullscreen();}catch{status.textContent='Full screen is unavailable. Open the provider’s player below.';}});
});
</script>